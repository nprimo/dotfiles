# File-name patterns the pi wrapper masks inside the container.
# One glob per line; lines starting with # and blank lines are ignored.
# Matching files get /dev/null mounted over them (appear empty);
# matching directories get an empty tmpfs.
#
# Edit freely — the wrapper reads this at every launch, no rebuild needed.

.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
.netrc
.git-credentials
.htpasswd
credentials.json
client_secret*.json
service-account*.json
*.keystore
secrets/
.secrets/
